# Copy to .env and fill in. .env is git-ignored and never leaves your machine.
TYPESAFE_API_KEY=
# LiteLLM model string for the LLM judge, e.g. the model your Judge stage uses
JUDGE_MODEL=
# Only if you route through your LiteLLM proxy:
JUDGE_API_BASE=
JUDGE_API_KEY=
# Optional: minimum seconds between judge calls (rate limits)
JUDGE_MIN_INTERVAL_S=
